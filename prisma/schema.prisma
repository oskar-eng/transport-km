generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CONDUCTOR")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders            ServiceOrder[]
  pushSubscriptions PushSubscription[]
  driverProfile     DriverProfile?
  sanciones         Sancion[]
}

model DriverProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  dni             String    @unique
  firstName       String
  lastName        String
  licenseNumber   String
  licenseCategory String    // A-I | A-IIa | A-IIb | A-IIIa | A-IIIb | A-IIIc | B-I | B-IIa | B-IIb | B-IIc
  licenseExpiry   DateTime
  phone           String?
  joinDate        DateTime?
  status          String    @default("ACTIVO") // ACTIVO | INACTIVO | SUSPENDIDO
  driverType      String?   // CAMION | OTRO
  photoUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User             @relation(fields: [userId], references: [id])
  documents DriverDocument[]
}

model DriverDocument {
  id         String    @id @default(cuid())
  driverId   String
  type       String    // DNI | LICENCIA | PBIP | ANT_POLICIALES | ANT_PENALES | SCTR
  expiryDate DateTime?
  fileUrl    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, type])
}

model Unit {
  id              String    @id @default(cuid())
  plate           String    @unique
  brand           String?
  model           String
  year            Int
  vin             String?
  vehicleType     String?
  axles           Int?
  loadCapacity    Float?
  fuelCapacity    Float?
  ownerCompany    String?
  status          String    @default("DISPONIBLE")
  localType       String?   // Puerto/Deposito | otro
  acquisitionDate DateTime?
  photoUrl        String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders        ServiceOrder[]
  documents     VehicleDocument[]
  unitDocuments UnitDocument[]
  fuelRecords   FuelRecord[]
  maintenance   MaintenanceRecord[]
  tires         Tire[]
  otherCosts    OtherCost[]
  expenses      Expense[]
  sanciones     Sancion[]
  workOrders       WorkOrder[]
  materialRequests MaterialRequest[]
  incidents        Incident[]
}

model Sancion {
  id          String    @id @default(cuid())
  unitId      String?
  driverId    String?   // userId del conductor
  type        String    // PAPELETA | INFRACCION | OTRO
  description String
  amount      Float?
  date        DateTime
  status      String    @default("PENDIENTE") // PENDIENTE | PAGADA | ANULADA
  documentUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  unit   Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  driver User? @relation(fields: [driverId], references: [id], onDelete: SetNull)
}

model Expense {
  id            String   @id @default(cuid())
  unitId        String
  category      String   // LLANTAS | ELECTRICO | REPUESTOS | OTROS
  description   String
  amount        Float
  date          DateTime
  receiptUrl    String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model UnitDocument {
  id         String    @id @default(cuid())
  unitId     String
  type       String    // HABILITACION | SOAT | REVISION_TECNICA | POLIZA | FOTO_PLACA | TARJETA_PROPIEDAD
  expiryDate DateTime?
  fileUrl    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, type])
}

model Trailer {
  id            String    @id @default(cuid())
  plate         String    @unique
  length        Float?    // Longitud (m)
  equipmentType String?   // Equipment Type (20 | 40 | otro)
  year          Int
  axles         Int?
  tare          Float?    // Tara (kg)
  localType     String?   // Puerto/Deposito | otro
  status        String    @default("DISPONIBLE")
  photoUrl      String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  documents TrailerDocument[]
}

model TrailerDocument {
  id         String    @id @default(cuid())
  trailerId  String
  type       String    // TARJETA_PROPIEDAD | HABILITACION | REVISION_TECNICA | POLIZA
  expiryDate DateTime?
  fileUrl    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  trailer Trailer @relation(fields: [trailerId], references: [id], onDelete: Cascade)

  @@unique([trailerId, type])
}

model MaintenanceTemplate {
  id        String   @id @default(cuid())
  brand     String   // Foton | Volvo | Freightliner | etc.
  type      String   // A | B | C | OTRO
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items TemplateItem[]
}

model TemplateItem {
  id         String  @id @default(cuid())
  templateId String
  partId     String?
  partName   String
  quantity   Float   @default(1)

  template MaintenanceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model WorkOrder {
  id          String    @id @default(cuid())
  numero      Int
  unitId      String
  type        String    // PREVENTIVO | CORRECTIVO
  maintType   String?   // A | B | C
  templateId  String?
  status      String    @default("ABIERTA") // ABIERTA | EN_PROCESO | CERRADA
  description String?
  diagnosis   String?
  mechanic    String?
  laborCost   Float?
  odometer    Int?
  evidenceUrl String?
  testsDone   String?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  unit      Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  materials WorkOrderMaterial[]
}

model WorkOrderMaterial {
  id          String  @id @default(cuid())
  workOrderId String
  partId      String?
  partName    String
  quantity    Float
  unitCost    Float?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model MaterialRequest {
  id              String   @id @default(cuid())
  numero          Int
  unitId          String?
  requestedById   String?
  requestedByName String?
  date            DateTime
  material        String
  quantity        Float    @default(1)
  status          String   @default("PENDIENTE") // PENDIENTE | APROBADA | ENTREGADA | RECHAZADA
  photoUrl        String?  // foto del material solicitado
  productPhotoUrl String?  // foto del producto recibido
  receiptUrl      String?  // comprobante / factura
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  unit Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
}

model Incident {
  id          String   @id @default(cuid())
  numero      Int
  unitId      String?
  driverId    String?
  driverName  String?
  date        DateTime
  description String
  severity    String   @default("MEDIA") // BAJA | MEDIA | ALTA
  status      String   @default("ABIERTA") // ABIERTA | EN_REVISION | RESUELTA
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
}

model SparePart {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  category  String?  // FILTROS | FRENOS | MOTOR | ELECTRICO | SUSPENSION | LLANTAS | OTRO
  brand     String?  // marca compatible (Foton, Volvo, etc.)
  unit      String   @default("UND") // unidad de medida
  stock     Float    @default(0)
  minStock  Float    @default(0)     // stock crítico
  cost      Float?   // costo unitario
  location  String?  // ubicación física
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]
}

model StockMovement {
  id            String   @id @default(cuid())
  partId        String
  type          String   // INGRESO | SALIDA
  quantity      Float
  reason        String?  // compra | orden de trabajo | ajuste | devolución
  reference     String?  // Nro OT / factura
  cost          Float?
  balance       Float    // saldo después del movimiento (kardex)
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  part SparePart @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model Solicitud {
  id            String    @id @default(cuid())
  numero        Int
  tipo          String    // MODIFICACION | ASOCIACION
  entidad       String    // CHOFER | CAMION | CARRETA
  docOrPlate    String    // Nro Doc / Placa
  entityName    String?   // nombre del conductor o modelo
  localType     String?
  docType       String?   // documento subido (Licencia, SOAT, etc.)
  fileUrl       String?
  expiryDate    DateTime?
  estado        String    @default("APROBADA") // APROBADA | PENDIENTE | RECHAZADA
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ServiceOrder {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  type            String
  status          String   @default("PENDIENTE")
  clientName      String
  origin          String?
  destination     String?
  containerNumber String?
  driverId        String
  unitId          String
  shareToken      String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  driver User          @relation(fields: [driverId], references: [id])
  unit   Unit          @relation(fields: [unitId], references: [id])
  events ServiceEvent[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model OtherCost {
  id          String   @id @default(cuid())
  unitId      String
  category    String   // PEAJE | SEGURO | LLANTAS | CONDUCTOR | ADMINISTRATIVO | OTRO
  description String
  amount      Float
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])
}

model Tire {
  id                  String   @id @default(cuid())
  unitId              String
  brand               String
  size                String
  position            String   // DEL_IZQ | DEL_DER | TRA_IZQ_EXT | TRA_IZQ_INT | TRA_DER_EXT | TRA_DER_INT | REPUESTO
  installDate         DateTime
  installOdometer     Int
  currentOdometer     Int
  status              String   @default("ACTIVO") // ACTIVO | DESGASTADO | REPARACION | BAJA
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])
}

model MaintenanceRecord {
  id               String   @id @default(cuid())
  unitId           String
  type             String   // PREVENTIVO | CORRECTIVO | PREDICTIVO
  status           String   @default("PENDIENTE") // PENDIENTE | EN_PROCESO | COMPLETADO
  description      String
  date             DateTime
  odometer         Int
  workshop         String?
  technician       String?
  cost             Float?
  nextDate         DateTime?
  nextOdometer     Int?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])
}

model FuelRecord {
  id           String   @id @default(cuid())
  unitId       String
  date         DateTime
  liters       Float
  pricePerLiter Float?
  totalCost    Float?
  odometer     Int
  station      String?
  fuelType     String   @default("DIESEL") // DIESEL | GASOLINA | GNV
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])
}

model VehicleDocument {
  id          String   @id @default(cuid())
  unitId      String
  type        String   // SOAT | REVISION_TECNICA | SEGURO | PERMISO_MTC | CERTIFICADO | OTRO
  name        String
  issueDate   DateTime?
  expiryDate  DateTime
  fileUrl     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])
}

model ServiceEvent {
  id             String   @id @default(cuid())
  serviceOrderId String
  eventType      String
  timestamp      DateTime @default(now())
  odometer       Int?
  notes          String?
  latitude       Float?
  longitude      Float?

  order ServiceOrder @relation(fields: [serviceOrderId], references: [id])
}
